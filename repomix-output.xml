  const pathColor = isStable ? "#00A3FF" : "#ef4444";
  
  return (
    <div className="lg:hidden mt-6 h-16 w-full rounded-md border border-white/5 bg-[#0A0A0A] p-2 flex items-center relative overflow-hidden">
