<file path="app/globals.css">
/* app/globals.css */

/* 1. La única directiva necesaria para Tailwind v4 */
@import "tailwindcss";

/* 2. Definición de variables CSS para fuentes (coinciden con el Layout) */
:root {
  --font-space-grotesk: 'Space Grotesk', sans-serif;
  --font-jetbrains: 'JetBrains Mono', monospace;
}

/* 3. Textura global (Noise para Dark Mode) */
/* app/globals.css */


.noise-overlay {
  background-image: url("https://grainy-gradients.vercel.app/noise.svg");
  opacity: 0.05; /* Un poco más alto para compensar la falta de overlay */
  pointer-events: none;
  position: fixed;
  inset: 0;
  z-index: 50;
  /* La magia del rendimiento: obliga al navegador a tratar esto como su propia capa GPU */
  transform: translateZ(0); 
  will-change: transform;
}

/* 2. CLASE DE UTILIDAD: Para elementos que usan Framer Motion */
.gpu-accelerated {
  transform: translateZ(0);
  backface-visibility: hidden;
  perspective: 1000px;
}

/* 4. Ocultar scrollbar nativa para SmoothScroll */
::-webkit-scrollbar {
  width: 0px;
  background: transparent;
}

/* 5. EFECTO NEO-BRUTALISTA: Glow duro para elementos activos */
.neo-brutal-glow {
  box-shadow: 0 0 25px rgba(0, 163, 255, 0.4); 
}
/* Animaciones para el Muro de Confianza (Masonry Marquee) */
@keyframes marquee-left {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@keyframes marquee-right {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

.animate-marquee-left {
  animation: marquee-left 45s linear infinite;
  width: max-content;
}

.animate-marquee-right {
  animation: marquee-right 45s linear infinite;
  width: max-content;
}

/* Pausa elegante al interactuar */
.marquee-container:hover .animate-marquee-left,
.marquee-container:hover .animate-marquee-right {
  animation-play-state: paused;
}
</file>

