// src/components/sections/Hero.tsx
"use client";

import React, { useRef } from "react";
import { motion } from "framer-motion";
import { ArrowUpRight, Activity, ThermometerSun } from "lucide-react";
import { Canvas, useFrame } from "@react-three/fiber";
import { Float } from "@react-three/drei";
import type { Mesh } from "three";

// --- 1. COMPONENTE 3D: EL OBJETO ---
function IndustrialCore() {
  const meshRef = useRef<Mesh>(null);

  useFrame((state, delta) => {
    if (meshRef.current) {
      // Movimiento lento y controlado para mantener la elegancia
      meshRef.current.rotation.x += delta * 0.1;
      meshRef.current.rotation.y += delta * 0.15;
    }
  });

  return (
    <Float speed={1.5} rotationIntensity={0.5} floatIntensity={2}>
      <mesh ref={meshRef} scale={1.8}>
        {/* Geometría suave pero ligera (32x64) perfecta para mantener 60 FPS constants */}
        <torusGeometry args={[2, 0.6, 32, 64]} />
        {/* Usamos meshStandardMaterial: Es el material físico nativo más robusto. 
          Usamos un color gris plomo (#1a1a1a) para que el aro se note y reciba form light.
        */}
        <meshStandardMaterial 
          color="#1a1a1a" // Un gris plomo para que el aro se note y no se pierda en el fondo negro
          roughness={0.2} 
          metalness={0.9} 
        />
      </mesh>
    </Float>
  );
}

// --- 2. EL ESCUDO: CANVAS MEMOIZADO (FOCO ATMOSFÉRICO NEO-BRUTALISTA) ---
// React.memo evita re-renderizados innecesarios y protege el contexto WebGL.
const Background3D = React.memo(() => {
  return (
    // Contenedor principal con un margen superior (top-4) para que flote
    <div className="absolute inset-0 z-0 opacity-80 pointer-events-none mix-blend-screen gpu-accelerated overflow-hidden">
      
      {/* CAPA DE DEGRADADO CSS (OPTIMIZADA): Foco azul atmosférico que se desvanece por completo */}
      <div 
        className="absolute inset-0 z-0"
        style={{ background: 'linear-gradient(180deg, rgba(0, 163, 255, 0.8) 0%, rgba(0, 163, 255, 0.2) 20%, rgba(0, 0, 0, 0) 40%)' }}
      ></div>

      <div className="absolute inset-0 z-10">
        <Canvas 
          camera={{ position: [0, 0, 8], fov: 45 }}
          dpr={[1, 1.5]} 
          // Configuraciones críticas para la estabilidad del WebGL
          gl={{ antialias: false, powerPreference: "high-performance", alpha: true, stencil: false, depth: false }} 
        >
          {/* Iluminación Focal Azul Potente desde Arriba */}
          <ambientLight intensity={0.5} />
          {/* Luces direccionales blancas/grises para dar forma y brillo al aro metálico */}
          <directionalLight position={[10, 10, 5]} intensity={2} color="#ffffff" />
          <directionalLight position={[-10, -10, -5]} intensity={1} color="#ffffff" />
          
          <IndustrialCore />
        </Canvas>
      </div>
    </div>
  );
});

// Nombrar el componente memoizado es buena práctica para las herramientas de desarrollo de React
Background3D.displayName = "Background3D";


// --- 3. COMPONENTE PRINCIPAL: HERO ---
export default function Hero() {
  const EASE_ELITE = [0.16, 1, 0.3, 1] as const;

